<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaDemo.MainWindow"
        Title="AvaloniaDemo" Width="1024" Height="668">
  <!-- The same six controls, same accessible names, as UnoDemo's surface. -->
  <StackPanel Margin="20" Spacing="12" HorizontalAlignment="Left">
    <TextBlock Text="Accessibility parity surface" FontWeight="Bold"/>
    <Button   AutomationProperties.Name="Open File Manager" Content="Open File Manager"/>
    <Button   AutomationProperties.Name="Save Document"     Content="Save Document"/>
    <TextBox  AutomationProperties.Name="Search box"        Watermark="Type to search..."/>
    <CheckBox AutomationProperties.Name="Enable notifications" Content="Enable notifications"/>
    <Slider   AutomationProperties.Name="Volume" Minimum="0" Maximum="100" Value="50" Width="220"/>
    <ComboBox AutomationProperties.Name="Theme selector" SelectedIndex="0">
      <ComboBoxItem>Light</ComboBoxItem>
      <ComboBoxItem>Dark</ComboBoxItem>
    </ComboBox>
  </StackPanel>
</Window>
